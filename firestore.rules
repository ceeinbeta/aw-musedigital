rules_version = '2';

// Enquiries and newsletter subscribers contain personal data. They are read
// and written only by the website's server, through the Admin SDK, which is
// not subject to these rules. Browsers and apps are denied everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
