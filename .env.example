# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash (e.g. the production domain once chosen).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Amazon Associates tracking ID for Amazon.es (supplied by the site owner).
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Sanity CMS. Create a project at sanity.io, then paste its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Forms (server-side secrets: never prefix these with NEXT_PUBLIC_) ---

# Firebase. On Firebase App Hosting, credentials are provided automatically.
# For local testing against real Firestore, point this at a service-account
# key file. Without it, local submissions are written to .data/store.json.
GOOGLE_APPLICATION_CREDENTIALS=

# Email sending through resend.com. Without these, enquiries are still saved
# but no notification is sent, and newsletter sign-ups skip the confirmation email.
RESEND_API_KEY=
EMAIL_FROM=
ENQUIRY_TO_EMAIL=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When set,
# a cookie consent banner appears and analytics loads only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shared secret for the Sanity webhook that refreshes the site when content is
# published (POST /api/revalidate). Any long random string.
SANITY_REVALIDATE_SECRET=
